digraph ERWarehouse {
    graph [
        rankdir=LR,
        splines=polyline,
        nodesep=0.95,
        ranksep=1.15,
        pad=0.35,
        bgcolor="white",
        fontname="Helvetica"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fillcolor="#eff6ff",
        color="#1d4ed8",
        penwidth=1.3,
        fontname="Helvetica",
        fontsize=18,
        margin="0.22,0.14"
    ];

    edge [
        color="#1d4ed8",
        penwidth=1.35,
        arrowsize=0.85,
        fontname="Helvetica",
        fontsize=12
    ];

    Employees [label="Employees"];
    Materials [label="Materials"];
    Warehouses [label="Warehouses"];
    InventoryBalances [label="InventoryBalances"];
    PurchaseOrders [label="PurchaseOrders"];
    PurchaseOrderItems [label="PurchaseOrderItems"];
    DeliveryReceipts [label="DeliveryReceipts"];
    DeliveryReceiptItems [label="DeliveryReceiptItems"];
    QualityInspections [label="QualityInspections"];
    QualityInspectionItems [label="QualityInspectionItems"];
    Suppliers [label="Suppliers"];
    VendorClaims [label="VendorClaims"];
    VendorClaimItems [label="VendorClaimItems"];
    MaterialTransactionTypes [label="MaterialTransactionTypes"];
    MaterialTransactions [label="MaterialTransactions"];
    MaterialTransactionItems [label="MaterialTransactionItems"];
    AuditLogs [label="AuditLogs"];

    Employees -> Warehouses [label="manages"];
    Warehouses -> InventoryBalances [label="stores"];
    Materials -> InventoryBalances [label="stock balance"];

    PurchaseOrders -> DeliveryReceipts [label="delivered as"];
    Warehouses -> DeliveryReceipts [label="received into"];
    Employees -> DeliveryReceipts [label="received by"];
    DeliveryReceipts -> DeliveryReceiptItems [label="1 to N"];
    PurchaseOrderItems -> DeliveryReceiptItems [label="receipt detail"];
    Materials -> DeliveryReceiptItems [label="received material"];

    DeliveryReceipts -> QualityInspections [label="1 to N"];
    Employees -> QualityInspections [label="inspects"];
    QualityInspections -> QualityInspectionItems [label="1 to N"];
    DeliveryReceiptItems -> QualityInspectionItems [label="inspection detail"];
    Materials -> QualityInspectionItems [label="inspection material"];

    Suppliers -> VendorClaims [label="claim against"];
    PurchaseOrders -> VendorClaims [label="related order"];
    QualityInspections -> VendorClaims [label="origin inspection"];
    VendorClaims -> VendorClaimItems [label="1 to N"];
    QualityInspectionItems -> VendorClaimItems [label="claimed inspection line"];
    Materials -> VendorClaimItems [label="claimed material"];

    MaterialTransactionTypes -> MaterialTransactions [label="classifies"];
    Warehouses -> MaterialTransactions [label="affects"];
    PurchaseOrders -> MaterialTransactions [label="references"];
    DeliveryReceipts -> MaterialTransactions [label="origin"];
    Employees -> MaterialTransactions [label="posts"];
    MaterialTransactions -> MaterialTransactionItems [label="1 to N"];
    Materials -> MaterialTransactionItems [label="movement item"];

    Employees -> AuditLogs [label="changes logged"];
}

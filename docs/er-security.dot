digraph ERSecurity {
    graph [
        rankdir=LR,
        splines=polyline,
        nodesep=0.95,
        ranksep=1.1,
        pad=0.35,
        bgcolor="white",
        fontname="Helvetica"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fillcolor="#f8fafc",
        color="#334155",
        penwidth=1.3,
        fontname="Helvetica",
        fontsize=20,
        margin="0.22,0.14"
    ];

    edge [
        color="#475569",
        penwidth=1.35,
        arrowsize=0.85,
        fontname="Helvetica",
        fontsize=13
    ];

    BusinessPartners [label="BusinessPartners\n(supertype)"];
    Employees [label="Employees\n(subtype)"];
    Suppliers [label="Suppliers\n(subtype)"];
    UserGroups [label="UserGroups"];
    AppUsers [label="AppUsers"];
    UserGroupMembers [label="UserGroupMembers"];
    SupplierContacts [label="SupplierContacts"];

    BusinessPartners -> Employees [label="1 to 0..1"];
    BusinessPartners -> Suppliers [label="1 to 0..1"];
    UserGroups -> Employees [label="1 to N"];
    Employees -> AppUsers [label="1 to N"];
    AppUsers -> UserGroupMembers [label="1 to N"];
    UserGroups -> UserGroupMembers [label="1 to N"];
    Suppliers -> SupplierContacts [label="1 to N"];
}
